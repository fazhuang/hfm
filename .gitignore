# ==============================================================================
# Workspace governance — long-term ignore rules (WG-02-R1 FINAL-IGNORE-RULE-PLAN)
# Only deterministic/regenerable intermediates; formal assets are NEVER ignored.
# ==============================================================================

# Video production workspace (relocated outside the HFM repository)
video-production/

# Content OCR / text-extraction intermediate dumps
content-production/corpus/extracted-text/
content-production/corpus/raw-ocr/
content-production/corpus/work/
content-production/corpus/jiayi-wikisource/

# Batch OCR / frame-extraction intermediates
content-production/batches/*/raw-ocr/
content-production/batches/*/extracted-text/
content-production/batches/*/rendered-pages/
content-production/batches/*/*/raw-ocr/
content-production/batches/*/*/rendered-pages/
content-production/batches/*/video/frames/
content-production/batches/*/images/derivatives/
content-production/batches/*/images/thumbs/

# Intermediate run statistics / execution profiles
content-production/batches/*/ocr-run-stats.json
content-production/batches/*/pdf-profile.json
content-production/batches/*/performance.json
content-production/batches/*/routeA-stats.json

# Temporary automation artifacts
.playwright-cli/

# Generated public derivatives (redacted P2 material, policy §4.1)
public-derivatives/

# Claude Code project config (local only, not shared)
.claude/settings.json
.claude/settings.local.json
