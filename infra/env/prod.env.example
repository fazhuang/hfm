# HFM environment: production
# P2-07 deployment/operations foundation (ADR-P2-02).
# Placeholders only — real values are injected at deploy time by the operator.
# The production database is never named dev/test and never shares credentials
# with them (environment separation, P2-07-AC-01).
HFM_ENV=prod
DATABASE_URL=postgresql+asyncpg://CHANGEME:CHANGEME@CHANGEME:5432/hfm_prod
PUBLIC_BASE_URL=https://CHANGEME.example
API_BASE_URL=https://CHANGEME.example
LOG_LEVEL=warn
