# HFM environment: production (ND-1 B01 — real HFM_* runtime inputs).
#
# Placeholders only — never commit real values. The operator copies this file
# to an uncommitted path (e.g. infra/env/prod.env or a deploy-time secret
# store) and fills real values. `scripts/deploy-gate.sh` runs
# `scripts/validate-production-env.py`, which REJECTS this template file, any
# missing value and any known development default — without printing the
# actual value (redacted diagnostics).
#
# The application (hfm.core.config) and Alembic (alembic/env.py) read
# HFM_DATABASE_URL. The pre-ND1 template only declared DATABASE_URL, which the
# runtime never reads and which could silently fall back to the local default
# database; production now declares the real HFM_* inputs and the preflight
# fails closed when they are absent or template-like.
HFM_ENV=prod

# Real PostgreSQL DSN: postgresql+asyncpg://user:password@host:port/dbname.
# The database is never named with the development/test suffixes and never
# reuses development/test credentials. A private co-located PostgreSQL host is
# supported (the backend runs on a private interface behind the proxy).
HFM_DATABASE_URL=postgresql+asyncpg://CHANGEME:CHANGEME@CHANGEME:5432/CHANGEME

# HMAC token-signing secret (hfm.phase1.auth). Minimum 32 characters; never
# the development default and never shared with development/test.
HFM_TOKEN_SECRET=CHANGEME_AT_LEAST_32_CHARACTERS_LONG

# Optional: absolute path to the persistent media volume the backend serves
# (published media only; bytes are never stored in the relational database).
HFM_MEDIA_ROOT=/var/lib/hfm/media

# Public/API origins used by the operational documentation (operator-owned
# inputs; not consumed by the backend process itself).
HFM_PUBLIC_BASE_URL=https://CHANGEME.example
HFM_API_BASE_URL=https://CHANGEME.example
LOG_LEVEL=warn

# NOTE: the legacy DATABASE_URL key below is retained ONLY so the historical
# template-shape check (scripts/check-env.sh) keeps passing for the prod
# matrix. Neither the application nor Alembic reads it; HFM_DATABASE_URL is
# the single authoritative database input, enforced by the ND-1 preflight.
DATABASE_URL=postgresql+asyncpg://CHANGEME:CHANGEME@CHANGEME:5432/CHANGEME
PUBLIC_BASE_URL=https://CHANGEME.example
API_BASE_URL=https://CHANGEME.example
